# Servidor
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Segurança
JWT_SECRET=troque-esta-chave
JWT_EXPIRES=12h
SEED_ADMIN_EMAIL=admin@primesul.com.br
SEED_ADMIN_PASS=defina-uma-senha-forte
SEED_ADMIN_PHONE=5511999990000

# Rate-limit (login + cadastro público). false = desativado (dev/teste)
RATE_LIMIT_ENABLED=true

# Banco
DB_PATH=./data/prime-sul.db

# Bot WhatsApp
BOT_ENABLED=false
MOCK_WHATSAPP=false
BOT_SESSIONS_DIR=./data/sessions
BOT_MAIN_NUMBER=5511999990000
BOT_MAIN_WELCOME="Olá! Aqui é a Prime Sul. Você pediu uma simulação de crédito. Posso pedir para um vendedor encaminhar a simulação?"
BOT_CONFIRM_KEYWORDS=sim,sim,ok,confirmo,quero,claro,pode,pode sim
BOT_DENY_KEYWORDS=nao,não,nope,dispenso,obrigado
BOT_OPTOUT_KEYWORDS=pare,parar,sair,cancelar,remover,nao quero,não quero
BOT_SELLER_WELCOME="Olá {nome}! Sou da equipe Prime Sul. Recebemos sua confirmação e vou continuar sua simulação de crédito por aqui."

# Fila de disparo
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_DELAY_MS=15000
